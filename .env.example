# WARNING: Never add real secrets to this file. Use only variable names and dummy/placeholder values.
# Real values go in .env.local (which is gitignored).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retell AI
RETELL_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (Email)
RESEND_API_KEY=

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# OAuth — Google (Calendar + Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# OAuth — HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# OAuth — Calendly
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# OAuth — QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Set to "true" to use QuickBooks sandbox API
QUICKBOOKS_SANDBOX=

# OAuth — Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# OAuth — GoHighLevel
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# OAuth — Housecall Pro
HOUSECALLPRO_CLIENT_ID=
HOUSECALLPRO_CLIENT_SECRET=

# Webhook — Housecall Pro (shared secret for inbound webhook validation)
HOUSECALLPRO_WEBHOOK_SECRET=

# OAuth — Jobber
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Webhook — Jobber (shared secret for inbound webhook validation)
JOBBER_WEBHOOK_SECRET=

# Retell Tools API Key (shared secret for Retell custom tool auth)
RETELL_TOOLS_API_KEY=

# Demo Call Agents (marketing live demo)
RETELL_AGENT_HEALTHCARE=
RETELL_AGENT_LEGAL=
RETELL_AGENT_HOME_SERVICES=
RETELL_AGENT_REAL_ESTATE=
RETELL_AGENT_INSURANCE=
RETELL_AGENT_FINANCIAL=
RETELL_AGENT_AUTOMOTIVE=
RETELL_AGENT_HOSPITALITY=
RETELL_FROM_NUMBER=

# Marketing Checkout Plan Mapping
PLATFORM_PLAN_ID_STARTER=
PLATFORM_PLAN_ID_PROFESSIONAL=

# Contact Form
CONTACT_FORM_EMAIL=

# Twilio (optional — SMS features degrade gracefully without these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # Used by src/lib/twilio.ts sendSms() for platform-initiated SMS (notifications, onboarding test calls)
TWILIO_FROM_NUMBER=           # Used by /api/tools/sms/send and /api/tools/confirmation/send for AI-agent-initiated SMS during calls
TWILIO_MESSAGING_SERVICE_SID=

# Twilio SIP Trunk (for connecting purchased numbers to Retell)
TWILIO_SIP_TRUNK_SID=
TWILIO_SIP_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Hiya Connect (for branded caller ID)
HIYA_APP_ID=
HIYA_APP_SECRET=

# Vercel Cron job authentication (required for /api/cron/* endpoints)
CRON_SECRET=

# Marketing site URL (used for CORS validation on checkout)
MARKETING_SITE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring & Logging
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
LOG_LEVEL=info

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook Secrets
RESEND_INBOUND_SECRET=

# Configurable URLs
RETELL_API_BASE=https://api.retellai.com
EMAIL_DOMAIN=invarialabs.com
NEXT_PUBLIC_CDN_WIDGET_URL=https://cdn.invaria.ai/chat-widget.js
NEXT_PUBLIC_EMBED_WIDGET_URL=https://embed.invarialabs.com/widget.js
